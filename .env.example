# ━━━━━━━━━━━━━━━━━━━━
# Application
# ━━━━━━━━━━━━━━━━━━━━
APP_ENV=production
APP_NAME=Spendwise
DEBUG=false

# ━━━━━━━━━━━━━━━━━━━━
# PostgreSQL
# ━━━━━━━━━━━━━━━━━━━━
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=spendwise
DATABASE_URL=postgresql+asyncpg://spendwise:change-me-strong-password@postgres:5432/spendwise
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ━━━━━━━━━━━━━━━━━━━━
# JWT
# ━━━━━━━━━━━━━━━━━━━━
SECRET_KEY=generate-this-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ━━━━━━━━━━━━━━━━━━━━
# Redis
# ━━━━━━━━━━━━━━━━━━━━
REDIS_URL=redis://redis:6379/0

# ━━━━━━━━━━━━━━━━━━━━
# CORS
# ━━━━━━━━━━━━━━━━━━━━
CORS_ORIGINS=["https://finance.lalonhobekotodine.sbs"]

# ━━━━━━━━━━━━━━━━━━━━
# GitHub (for compose pull)
# ━━━━━━━━━━━━━━━━━━━━
GITHUB_REPO=avsk-net

# ━━━━━━━━━━━━━━━━━━━━
# SMTP (optional)
# ━━━━━━━━━━━━━━━━━━━━
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=