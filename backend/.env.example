# ─── SpendWise Environment Variables ─────────────────────────────────────────
# Copy this file:
#   Self-hosting (Docker):  cp backend/.env.example .env        (repo root)
#   Local development:      cp backend/.env.example backend/.env
#
# Required fields are marked with [REQUIRED]. Everything else has a safe default.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=change_me_strong_password   # [REQUIRED] change this
POSTGRES_DB=spendwise

# ── Database connection ───────────────────────────────────────────────────────
# Docker:     hostname = "postgres"  (Docker service name)
# Local dev:  hostname = "localhost"
DATABASE_URL=postgresql+asyncpg://spendwise:change_me_strong_password@postgres:5432/spendwise  # [REQUIRED] update password

# ── JWT secret ────────────────────────────────────────────────────────────────
# Generate a strong random key:  openssl rand -hex 32
SECRET_KEY=replace_with_64_random_hex_chars  # [REQUIRED]

# ── Redis ─────────────────────────────────────────────────────────────────────
# Docker:     hostname = "redis"
# Local dev:  hostname = "localhost"
REDIS_URL=redis://redis:6379/0

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_VERSION=1.0.0
DEBUG=false

# Public URL of your instance — used to build links inside emails (password
# reset, email verification). Must match the domain users visit.
APP_BASE_URL=https://finance.example.com  # [REQUIRED] change to your domain

# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array. Must match the domain your frontend is served from.
# No trailing slash.
CORS_ORIGINS=["https://finance.example.com"]  # [REQUIRED] change to your domain

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Needed for email verification and password reset emails.
# Without this, user registration works but no emails are sent.
#
# Free SMTP providers: Brevo (300/day), Mailgun, SendGrid, Resend.
# IMPORTANT: SMTP_FROM must be a verified sender in your provider — otherwise
# Gmail and others will silently drop the message.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_login
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@finance.example.com
SMTP_USE_TLS=true

# ── Docker image tags ─────────────────────────────────────────────────────────
# Used by docker-compose.yml to reference built images.
# Self-hosters: set this to your GitHub username/repo (or any string), then
# build with:
#   docker build -t ghcr.io/<GITHUB_REPO>/spendwise-api:latest ./backend
#   docker build -t ghcr.io/<GITHUB_REPO>/spendwise-frontend:latest ./frontend
GITHUB_REPO=avsk-net/spendwise

# ── Token lifetimes (optional) ────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Rate limiting (optional) ──────────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_FORGOT_PASSWORD=3/hour
RATE_LIMIT_RESEND_VERIFICATION=3/hour

# ── Database pool (optional, tune for your server RAM) ───────────────────────
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
