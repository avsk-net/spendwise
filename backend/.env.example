# ── Postgres (used by both docker-compose variable substitution and the app) ───
POSTGRES_USER=spendwise
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=spendwise

# ── App ────────────────────────────────────────────────────────────────────────
# In production, hostname is the docker service name "postgres" (not localhost)
DATABASE_URL=postgresql+asyncpg://spendwise:change-this-strong-password@postgres:5432/spendwise
SECRET_KEY=change-this-to-a-64-char-random-string
APP_ENV=production

# ── Redis ─────────────────────────────────────────────────────────────────────
# In production, hostname is the docker service name "redis"
REDIS_URL=redis://redis:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["https://finance.lalonhobekotodine.sbs"]

# ── Email (optional) ──────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ── Docker image registry ─────────────────────────────────────────────────────
# Must match the GitHub repository slug (lowercase), e.g. avsk-net/spendwise
GITHUB_REPO=avsk-net/spendwise
